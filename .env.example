# Copie este archivo a .env y ajuste los valores (en producción defina SECRET_KEY).
# Si SECRET_KEY no se define, se genera una al arrancar y las sesiones se pierden al reiniciar.
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria-de-32-caracteres-o-mas
TZ_CONSULTORIO=America/Bogota
JORNADA_INICIO=08:00
JORNADA_FIN=17:00
DURACION_CITA_MIN=30
TOKEN_MINUTOS=30
RECORDATORIO_HORAS=24
SEMBRAR_DATOS_DEMO=true
CONTRASENA_DEMO=Salud2026*
RECORDATORIOS_AUTOMATICOS=true

# Facturación electrónica distribuida (Unidad 2). Vacío = proveedor simulado dentro del mismo proceso.
# Lista de nodos proveedor separados por coma: NODOS_PROVEEDOR=127.0.0.1:9101,127.0.0.1:9102
NODOS_PROVEEDOR=
PROXY_TIMEOUT_SEG=3.0
PROXY_MAX_INTENTOS=4
CIRCUITO_FALLOS=3
CIRCUITO_ENFRIAMIENTO_SEG=2.0
