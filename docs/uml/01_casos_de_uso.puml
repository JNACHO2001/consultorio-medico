@startuml 01_casos_de_uso
' Diagrama de casos de uso - Sistema de Gestión "Salud Integral"
' Fuente: Documento de Levantamiento de Requerimientos, sección 10

left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45

title Diagrama de casos de uso\nSistema de Gestión "Salud Integral"

actor "Recepcionista" as REC
actor "Médico" as MED
actor "Administrador" as ADM
actor "Apoyo diagnóstico\n(laboratorio)" as LAB

rectangle "Sistema de Gestión – Salud Integral" {
  usecase "CU-02\nRegistrar paciente" as CU02
  usecase "CU-04\nAgendar cita" as CU04
  usecase "CU-05\nReprogramar o\ncancelar cita" as CU05
  usecase "CU-06\nConsultar agenda" as CU06
  usecase "CU-07\nRegistrar consulta\nmédica" as CU07
  usecase "CU-11\nGestionar usuarios\ny roles" as CU11
  usecase "CU-12\nConsultar bitácora\nde auditoría" as CU12
  usecase "CU-03\nBuscar paciente" as CU03
  usecase "CU-08\nConsultar historia\nclínica" as CU08
  usecase "CU-09\nAdjuntar documento\nclínico" as CU09
  usecase "CU-10\nEnviar recordatorio\nde cita" as CU10
  usecase "CU-01\nIniciar sesión" as CU01
  usecase "CU-13\nIngresar paciente" as CU13
  usecase "CU-14\nRegistrar procedimiento\nrealizado" as CU14
  usecase "CU-15\nFacturar y cobrar\nprocedimientos" as CU15
  usecase "CU-16\nGestionar catálogo\ny tarifas" as CU16
  usecase "CU-17\nGestionar pagadores\ny convenios" as CU17
  usecase "CU-18\nGestionar cartera:\nradicar, abonos y glosas" as CU18
  usecase "CU-19\nGenerar borrador\nde RIPS" as CU19
  usecase "CU-20\nSolicitar órdenes\ny diagnóstico CIE-10" as CU20
  usecase "CU-21\nRegistrar resultados\nde apoyo diagnóstico" as CU21
  usecase "CU-22\nEmitir factura electrónica\ny notas crédito" as CU22
  usecase "CU-23\nGestionar caja\ny recibos" as CU23
}

actor "Servicio de\nnotificaciones" as NOT <<sistema externo>>

REC --> CU02
REC --> CU04
REC --> CU05
REC --> CU06
REC --> CU03
REC --> CU13
REC --> CU15
REC --> CU18
REC --> CU22
REC --> CU23

MED --> CU14
MED --> CU20
MED --> CU21
MED --> CU06
MED --> CU07
MED --> CU03
MED --> CU08

ADM --> CU11
ADM --> CU12
ADM --> CU16
ADM --> CU17
ADM --> CU18
ADM --> CU19
ADM --> CU22
ADM --> CU23

LAB --> CU21

CU04 ..> CU03 : <<include>>
CU04 ..> CU10 : <<include>>
CU07 ..> CU08 : <<include>>
CU09 .up.> CU07 : <<extend>>
CU13 ..> CU03 : <<include>>
CU14 ..> CU08 : <<extend>>
CU13 ..> CU17 : <<include>>
CU18 ..> CU15 : <<extend>>
CU19 ..> CU18 : <<include>>
CU21 ..> CU14 : <<include>>
CU18 ..> CU22 : <<include>>
CU15 ..> CU23 : <<include>>

CU10 <-- NOT

note right of CU15
  El administrador consulta las facturas y gestiona su cartera.
  Cada procedimiento se factura una sola vez.
end note

note right of CU22
  Proveedor tecnológico SIMULADO: CUFE/CUDE y XML UBL 2.1
  simplificado, sin firma electrónica ni transmisión a la DIAN.
end note

note right of CU01
  Todos los casos de uso, excepto CU-01 y CU-10,
  incluyen CU-01 (<<include>>). Las flechas no se
  dibujan para mantener el diagrama legible.
end note

@enduml
