@startuml 02a_clases_dominio
' Diagrama de clases (vista 1): modelo de dominio
' Fuente: Documento de Levantamiento de Requerimientos, secciones 7 a 10

skinparam monochrome true
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 35
skinparam wrapWidth 220

title Diagrama de clases (1 de 2): modelo de dominio\nSistema de Gestión "Salud Integral"

enum Rol {
  RECEPCION
  MEDICO
  ADMINISTRADOR
}

enum EstadoCita {
  PROGRAMADA
  CANCELADA
  ATENDIDA
}

class Usuario {
  - id : Long
  - nombreUsuario : String
  - contrasenaHash : String
  - nombreCompleto : String
  - activo : Boolean
}

class Medico {
  - especialidad : String
  - registroMedico : String
}

class Paciente {
  - id : Long
  - tipoDocumento : String
  - numeroDocumento : String
  - nombres : String
  - apellidos : String
  - fechaNacimiento : Date
  - sexo : String
  - telefono : String
  - correo : String
  - eps : String
  - alergias : String
  - activo : Boolean
}

class Cita {
  - id : Long
  - fechaHora : DateTime
  - estado : EstadoCita
  - motivoCancelacion : String
}

class HistoriaClinica {
  - id : Long
  - fechaApertura : Date
}

class Consulta {
  - id : Long
  - fechaHora : DateTime
  - motivo : String
  - antecedentes : String
  - signosVitales : String
  - diagnostico : String
  - tratamiento : String
  - formula : String
  - observaciones : String
  - cerrada : Boolean
}

class NotaAclaratoria {
  - texto : String
  - fecha : DateTime
}

class Ingreso {
  - id : Long
  - fechaIngreso : DateTime
  - tipo : TipoIngreso
  - motivo : String
  - estado : EstadoIngreso
  - fechaEgreso : DateTime
  - resumenEgreso : String
  - numeroAutorizacion : String
  - diagnosticoPrincipal : CIE-10
}

class Procedimiento <<catálogo>> {
  - codigo : String
  - nombre : String
  - tarifa : Entero (pesos)
  - cups : String
  - tipoServicio : TipoServicio
}

class ProcedimientoRealizado {
  - id : Long
  - fechaHora : DateTime
  - cantidad : Entero
  - valorUnitario : Entero (pesos)
  - observaciones : String
  - anulado : Boolean
}

class Factura {
  - numero : String
  - fecha : DateTime
  - estado : EstadoFactura
  - metodoPago : MetodoPago
  - fechaPago : DateTime
  - motivoAnulacion : String
  - valorPaciente : Entero (pesos)
  - valorPagador : Entero (pesos)
  - fechaRadicacion : DateTime
  - numeroRadicacion : String
  + saldoPaciente() : Entero
  + saldoPagador() : Entero
  + saldada() : Boolean
}

class Pagador {
  - codigo : String
  - nombre : String
  - tipo : TipoPagador
  - nit : String
}

class Convenio {
  - nombre : String
  - porcentajeTarifa : Entero
  - copagoPorcentaje : Entero
  - cuotaModeradora : Entero (pesos)
  - requiereAutorizacion : Boolean
}

class PagoFactura {
  - origen : OrigenPago
  - metodo : MetodoPago
  - valor : Entero (pesos)
  - fecha : DateTime
  - referencia : String
  - reciboNumero : String
}

class OrdenClinica {
  - fecha : DateTime
  - area : AreaApoyo
  - prioridad : PrioridadOrden
  - indicacion : String
  - estado : EstadoOrden
  - observaciones : String
}

class ResultadoValor {
  - parametro : String
  - valor : Decimal
  - unidad : String
  - refMin : Decimal
  - refMax : Decimal
  + alterado() : Boolean
}

enum EstadoOrden {
  SOLICITADA
  REALIZADA
  ANULADA
}

class DocumentoElectronico {
  - tipo : TipoDocumentoElectronico
  - prefijo : String
  - consecutivo : Entero
  - adquirente : NIT o documento
  - valor : Entero (pesos)
  - cufe : SHA-384
  - xml : UBL 2.1
  - estado : EstadoDocumentoElectronico
  - codigoRespuesta : String
  - concepto : ConceptoNotaCredito
}

class EventoDocumento {
  - fecha : DateTime
  - estado : EstadoDocumentoElectronico
  - mensaje : String
}

enum EstadoDocumentoElectronico {
  GENERADO
  ACEPTADO
  RECHAZADO
}

class Caja <<turno>> {
  - cajero : Usuario
  - fechaApertura : DateTime
  - baseInicial : Entero (pesos)
  - estado : EstadoCaja
  - efectivoEsperado : Entero (pesos)
  - efectivoContado : Entero (pesos)
  - diferencia : Entero (pesos)
}

class Glosa {
  - concepto : ConceptoGlosa
  - motivo : String
  - valor : Entero (pesos)
  - estado : EstadoGlosa
  - respuesta : String
  - notaResolucion : String
}

enum EstadoGlosa {
  ABIERTA
  RESPONDIDA
  ACEPTADA
  LEVANTADA
}

enum TipoPagador {
  PARTICULAR
  EPS
  ARL
  SOAT
  PREPAGADA
}

class LineaFactura {
  - descripcion : String
  - cantidad : Entero
  - valorUnitario : Entero (pesos)
}

enum EstadoFactura {
  EMITIDA
  PAGADA
  ANULADA
}

class DocumentoAdjunto {
  - nombreArchivo : String
  - tipo : String
  - tamanoBytes : Long
  - ruta : String
}

class RegistroAuditoria {
  - id : Long
  - fechaHora : DateTime
  - accion : String
  - entidad : String
  - idEntidad : Long
}

Usuario <|-- Medico
Usuario "*" --> "1" Rol : tiene

Paciente "1" -- "1" HistoriaClinica : posee
HistoriaClinica "1" *-- "*" Consulta : contiene
Consulta "1" *-- "*" NotaAclaratoria : se corrige con
Consulta "1" *-- "*" DocumentoAdjunto : incluye

Cita "*" --> "1" Paciente : es de
Cita "*" --> "1" Medico : atiende
Cita --> EstadoCita
Consulta "0..1" --> "1" Cita : surge de
Consulta "*" --> "1" Medico : registra

Paciente "1" -- "*" Ingreso : es admitido en
Ingreso "*" --> "1" Medico : tratante
Ingreso "1" *-- "*" ProcedimientoRealizado : cuenta
HistoriaClinica "1" o-- "*" ProcedimientoRealizado : incluye
ProcedimientoRealizado "*" --> "1" Procedimiento : copia código y valor
ProcedimientoRealizado "*" --> "0..1" Factura : se factura en
Factura "*" --> "1" Ingreso
Factura "1" *-- "1..*" LineaFactura
Factura --> EstadoFactura
Pagador "1" *-- "*" Convenio : pacta
Ingreso "*" --> "1" Convenio : se atiende bajo
Factura "*" --> "1" Convenio : copia condiciones
Factura "1" *-- "*" PagoFactura : recibe
Factura "1" *-- "*" Glosa : puede tener
Pagador --> TipoPagador
Ingreso "1" *-- "*" OrdenClinica : se solicita en
OrdenClinica "*" --> "1" Procedimiento : pide
OrdenClinica "*" --> "1" Medico : solicita
OrdenClinica "1" *-- "*" ResultadoValor : resultado
OrdenClinica --> EstadoOrden
OrdenClinica "0..1" --> "1" ProcedimientoRealizado : al resultado carga
Factura "1" -- "*" DocumentoElectronico : factura electrónica y notas crédito
DocumentoElectronico "1" *-- "*" EventoDocumento : historial
DocumentoElectronico --> EstadoDocumentoElectronico
DocumentoElectronico "0..*" --> "1" DocumentoElectronico : nota crédito referencia
Caja "1" o-- "*" PagoFactura : recibos
Glosa --> EstadoGlosa

RegistroAuditoria "*" --> "1" Usuario : realizado por

note bottom of Consulta
  Una consulta cerrada no se modifica:
  solo se corrige con NotaAclaratoria (RN-04).
end note

note bottom of ProcedimientoRealizado
  El valor se copia del catálogo al registrarlo:
  un cambio de tarifa no altera lo ya realizado (RN-10).
  Un procedimiento se factura una sola vez (RN-12).
end note

note bottom of Convenio
  La tarifa del convenio se aplica al registrar el procedimiento (RN-14).
  La cuenta se reparte entre paciente y pagador (RN-15).
  Las glosas solo aplican a facturas radicadas (RN-18, RN-19).
end note

note bottom of OrdenClinica
  El ingreso no se egresa con órdenes solicitadas sin resultado (RN-20).
  Registrar el resultado carga el servicio a la cuenta al precio del convenio (RN-21).
end note

note bottom of DocumentoElectronico
  La factura electrónica va al pagador por su parte y, si no hay pagador, al paciente.
  Sin factura electrónica aceptada no se radica (RN-22); con ella se anula con nota crédito (RN-23).
  Una caja abierta por cajero (RN-24); cobrar al paciente exige caja abierta (RN-25).
end note

note bottom of Paciente
  tipoDocumento + numeroDocumento
  identifican de forma única (RN-01).
end note

@enduml
