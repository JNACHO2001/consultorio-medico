@startuml 02b_clases_repository
' Diagrama de clases (vista 2): servicios y patrón Repository
' Fuente: Documento de Levantamiento de Requerimientos, sección 11

left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 90

title Diagrama de clases (2 de 2): servicios y patrón Repository\nSistema de Gestión "Salud Integral"

' ---------- Capa de servicios de aplicación ----------
class PacienteService <<servicio>> {
  + registrarPaciente(datos) : Paciente
  + buscarPaciente(criterio) : List<Paciente>
  + actualizarPaciente(id, datos) : Paciente
}

class CitaService <<servicio>> {
  + consultarHorariosLibres(medicoId, fecha) : List<DateTime>
  + agendarCita(pacienteId, medicoId, fechaHora) : Cita
  + reprogramarCita(citaId, fechaHora) : Cita
  + cancelarCita(citaId, motivo) : void
  + consultarAgenda(medicoId, fecha) : List<Cita>
}

class ConsultaService <<servicio>> {
  + registrarConsulta(citaId, datos) : Consulta
  + cerrarConsulta(consultaId) : void
  + agregarNota(consultaId, texto) : void
  + consultarHistorial(pacienteId) : List<Consulta>
}

class IngresoService <<servicio>> {
  + admitir(pacienteId, medicoId, tipo, motivo) : Ingreso
  + registrarProcedimiento(ingresoId, procedimientoId, cantidad) : ProcedimientoRealizado
  + anularProcedimiento(ingresoId, id, motivo) : void
  + darEgreso(ingresoId, resumen) : Ingreso
}

class FacturacionService <<servicio>> {
  + facturar(ingresoId, procedimientoIds) : Factura
  + pagar(facturaId, metodo) : Factura
  + anular(facturaId, motivo) : Factura
}

class CatalogoService <<servicio>> {
  + crear(codigo, nombre, tarifa) : Procedimiento
  + actualizar(id, nombre, tarifa) : Procedimiento
}

class NotificacionService <<servicio>> {
  + programarRecordatorio(cita) : void
  + procesarPendientes(ahora) : List<Recordatorio>
}

class AutenticacionService <<servicio>> {
  + iniciarSesion(usuario, contrasena) : Sesion
  + cerrarSesion(sesion) : void
}

' ---------- Interfaces Repository (capa de dominio) ----------
interface IPacienteRepository {
  + obtenerPorDocumento(tipo, numero) : Paciente
  + buscar(texto) : List<Paciente>
  + obtenerPorIds(ids) : List<Paciente>
}

interface ICitaRepository {
  + obtenerPorMedicoYFecha(medicoId, fecha) : List<Cita>
  + existeCruce(medicoId, fechaHora) : Boolean
  + actualizarEstado(citaId, estado) : void
}

interface IConsultaRepository {
  + obtenerPorPaciente(pacienteId) : List<Consulta>
  + obtenerPorCita(citaId) : Consulta
  + agregarNota(consultaId, nota) : void
}

interface IIngresoRepository {
  + obtenerAbiertoPorPaciente(pacienteId) : Ingreso
  + buscar(estado, medicoId, pacienteId) : List<Ingreso>
}

interface IProcedimientoRealizadoRepository {
  + obtenerPorIngreso(ingresoId) : List<ProcedimientoRealizado>
  + obtenerPorPaciente(pacienteId) : List<ProcedimientoRealizado>
}

interface IFacturaRepository {
  + buscar(estado, pacienteId, ingresoId) : List<Factura>
}

interface IProcedimientoRepository {
  + obtenerPorCodigo(codigo) : Procedimiento
}

interface IUsuarioRepository {
  + obtenerPorNombreUsuario(nombre) : Usuario
}

interface IRecordatorioRepository {
  + obtenerPorCita(citaId) : Recordatorio
  + obtenerPendientes(hasta) : List<Recordatorio>
}

interface IAuditoriaRepository {
  + registrar(registro) : void
  + consultar(filtros) : List<RegistroAuditoria>
}

interface "IRepository<T>" as IRepository {
  + agregar(entidad : T) : T
  + obtenerPorId(id : Long) : T
  + listar(incluirInactivos : Boolean) : List<T>
  + actualizar(entidad : T) : T
  + desactivar(id : Long) : void
}

' ---------- Implementaciones (infraestructura) ----------
class MemoryPacienteRepository <<implementación>>
class MemoryCitaRepository <<implementación>>
class MemoryConsultaRepository <<implementación>>
class MemoryUsuarioRepository <<implementación>>
class MemoryRecordatorioRepository <<implementación>>
class MemoryAuditoriaRepository <<implementación>>
class MemoryIngresoRepository <<implementación>>
class MemoryProcedimientoRealizadoRepository <<implementación>>
class MemoryFacturaRepository <<implementación>>
class MemoryProcedimientoRepository <<implementación>>

class "Listas de objetos en memoria\n(base de datos del prototipo)" as BD <<almacén>>

' Los servicios dependen de interfaces, nunca de implementaciones
PacienteService ..> IPacienteRepository
CitaService ..> ICitaRepository
CitaService ..> IPacienteRepository
ConsultaService ..> IConsultaRepository
AutenticacionService ..> IUsuarioRepository
NotificacionService ..> IRecordatorioRepository
CitaService ..> NotificacionService : programa recordatorio
IngresoService ..> IIngresoRepository
IngresoService ..> IProcedimientoRealizadoRepository
IngresoService ..> CatalogoService : toma tarifa
FacturacionService ..> IFacturaRepository
FacturacionService ..> IProcedimientoRealizadoRepository
CatalogoService ..> IProcedimientoRepository

' Interfaz genérica común (T = entidad)
IPacienteRepository --|> IRepository
ICitaRepository --|> IRepository
IConsultaRepository --|> IRepository
IUsuarioRepository --|> IRepository
IRecordatorioRepository --|> IRepository
IIngresoRepository --|> IRepository
IProcedimientoRealizadoRepository --|> IRepository
IFacturaRepository --|> IRepository
IProcedimientoRepository --|> IRepository

' Implementaciones
MemoryPacienteRepository ..|> IPacienteRepository
MemoryCitaRepository ..|> ICitaRepository
MemoryConsultaRepository ..|> IConsultaRepository
MemoryUsuarioRepository ..|> IUsuarioRepository
MemoryRecordatorioRepository ..|> IRecordatorioRepository
MemoryAuditoriaRepository ..|> IAuditoriaRepository
MemoryIngresoRepository ..|> IIngresoRepository
MemoryProcedimientoRealizadoRepository ..|> IProcedimientoRealizadoRepository
MemoryFacturaRepository ..|> IFacturaRepository
MemoryProcedimientoRepository ..|> IProcedimientoRepository

' Auditoría disparada desde el repositorio (RF-13)
MemoryPacienteRepository ..> IAuditoriaRepository : registra accesos
MemoryConsultaRepository ..> IAuditoriaRepository : registra accesos
MemoryIngresoRepository ..> IAuditoriaRepository : registra accesos
MemoryProcedimientoRealizadoRepository ..> IAuditoriaRepository : registra accesos
MemoryFacturaRepository ..> IAuditoriaRepository : registra accesos

MemoryPacienteRepository --> BD
MemoryCitaRepository --> BD
MemoryConsultaRepository --> BD
MemoryUsuarioRepository --> BD
MemoryRecordatorioRepository --> BD
MemoryAuditoriaRepository --> BD
MemoryIngresoRepository --> BD
MemoryProcedimientoRealizadoRepository --> BD
MemoryFacturaRepository --> BD
MemoryProcedimientoRepository --> BD

note bottom of IRepository
  desactivar() hace borrado lógico:
  no existe eliminación física (RNF-11).
  T = Paciente, Cita, Consulta, Usuario, Ingreso,
  ProcedimientoRealizado, Factura, etc.
end note

note bottom of BD
  Solo las implementaciones acceden
  al almacén (RNF-09). Para producción
  se escriben clases Sql*Repository que
  cumplen las mismas interfaces; los
  servicios no cambian.
end note

@enduml
